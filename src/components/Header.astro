---
// Sticky site header: brand (links home), a tab per page (from nav.ts), and the light / dark toggle. On a phone the tabs
// give way to the current page's name and a menu button, which opens every page, grouped as on the home page.
import { nav } from '../data/nav';
import { SITE, GAME } from '../data/site';
import { url } from '../lib/url';

// A link is current when it matches this page's path (trailing slash optional).
const norm = (p: string) => p.replace(/index\.html$/, '').replace(/\/?$/, '/');
const here = norm(Astro.url.pathname);
// The logo and name link home, so the tabs are just the pages.
const links = nav.flatMap((g) => g.pages).map((l) => ({ ...l, href: url(l.href) }));
/** the page's name for the phone header: its tab's title, or the site's name on home and unlisted pages */
const hereTitle = links.find((l) => norm(l.href) === here)?.title ?? SITE;
---
<header class="site-header" transition:persist="site-header">
  <div class="container">
    <a class="brand" href={url()} aria-label={`${SITE}, home`} aria-current={norm(url()) === here ? 'page' : undefined}>
      <!-- the logo: an open grimoire with a fel rune, whose smoke rises, spills off to the right and underlines the name -->
      <span class="brand-in">
        <svg class="sigil" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <path class="b-cover" d="M1.2 12.2V25.6Q8.8 24.2 16 27.4Q23.2 24.2 30.8 25.6V12.2Q23.2 11.2 16 13.6Q8.8 11.2 1.2 12.2Z"/>
          <path class="b-edge" d="M2.6 11.4Q9.4 10 16 13V26Q9.4 23.4 2.6 24.6Z M29.4 11.4Q22.6 10 16 13V26Q22.6 23.4 29.4 24.6Z"/>
          <path class="b-page" d="M3 9.8Q9.6 8.2 16 11.6V24.6Q9.6 21.8 3 23Z M29 9.8Q22.4 8.2 16 11.6V24.6Q22.4 21.8 29 23Z"/>
          <path class="b-spine" d="M16 11.6V24.6"/>
          <path class="b-ink" d="M5.6 12.6Q9.6 11.8 13.6 13.6 M5.6 15.4Q9.6 14.6 13.6 16.4 M5.6 18.2Q9.6 17.4 13.6 19.2 M5.6 21Q8.4 20.4 11 21.4"/>
          <path class="b-rune" d="M25.6 17A3.1 3.1 0 1 1 19.4 17A3.1 3.1 0 1 1 25.6 17Z M22.5 13.9V20.1 M19.9 15.4L25.1 18.6 M25.1 15.4L19.9 18.6"/>
        </svg>
        <span class="name">{SITE}</span>
        <!-- from the rune (left) to just past the name; stretched to the name's width, so it follows the font -->
        <svg class="brand-smoke" viewBox="0 0 180 40" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="brand-smoke-fade" x1="0" x2="180" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-opacity=".95"/><stop offset=".5" stop-opacity=".6"/><stop offset="1" stop-opacity="0"/>
            </linearGradient>
            <!-- noise ruffles the strokes into wisps; a little blur softens them -->
            <filter id="brand-smoke-wisp" x="-10%" y="-40%" width="120%" height="180%">
              <feTurbulence type="fractalNoise" baseFrequency=".09 .16" numOctaves="2" seed="4" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="3" xChannelSelector="R" yChannelSelector="G" result="d"/>
              <feGaussianBlur in="d" stdDeviation=".7" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="d"/></feMerge>
            </filter>
          </defs>
          <g filter="url(#brand-smoke-wisp)">
            <path class="s-haze" d="M7.5 15.5C6.5 10 10 6.5 14 8C18 9.5 17 17 20.5 23.5C24 30 32 32.5 46 32.6C80 32.8 110 31.6 178 32.4"/>
            <path class="s-core" d="M7.5 15.5C6.5 10 10 6.5 14 8C18 9.5 17 17 20.5 23.5C24 30 32 32.5 46 32.6C80 32.8 110 31.6 178 32.4"/>
            <path class="s-wisp" d="M9 14C10 8 16 5 19 8.5C22 12 21 21 27 27.5C33 33.5 52 35 70 34.6C100 34 130 35.8 165 35"/>
            <path class="s-curl" d="M8.5 13C8 6.5 12 2.5 16.5 4.5C19.5 6 19 9.5 16.5 10"/>
            <path class="s-ripple" d="M30 30.6C50 29.2 70 31.6 90 30.5C110 29.5 130 31 150 30.3"/>
          </g>
        </svg>
      </span>
    </a>
    <nav class="nav" aria-label="Pages">
      {links.map((l) => <a href={l.href} aria-current={norm(l.href) === here ? 'page' : undefined}>{l.title}</a>)}
    </nav>
    <span class="here">{hereTitle}</span>
    <span class="game">for {GAME}</span>
    <button class="icon-btn theme-toggle" type="button" aria-label="Switch to light theme">
      <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="icon-btn menu-btn" type="button" aria-label="Pages" aria-expanded="false" aria-controls="mnav">
      <svg class="bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <!-- the phone menu: every page, in its group, with its blurb -->
  <nav class="mnav" id="mnav" aria-label="Pages" hidden>
    <div class="container">
      {nav.map((g) => (
        <div class="mnav-g">
          <span class="mnav-h">{g.group}</span>
          {g.pages.map((p) => (
            <a href={url(p.href)} aria-current={norm(url(p.href)) === here ? 'page' : undefined}><span class="mnav-t">{p.title}</span><span class="mnav-b">{p.blurb}</span></a>
          ))}
        </div>
      ))}
    </div>
  </nav>
</header>

<script>
  // The header persists across in-site navigation, so this runs once.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const label = () => btn.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  label();
  btn.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
    try { light ? localStorage.setItem('theme', 'light') : localStorage.removeItem('theme'); } catch {}
    label();
  });
  const norm = (p: string) => p.replace(/index\.html$/, '').replace(/\/?$/, '/');
  // Slide direction follows page order (home, then the tabs left to right): going further along slides left,
  // going back slides right. The Back / Forward buttons already set the direction themselves.
  const order = [new URL(document.querySelector<HTMLAnchorElement>('.brand')!.href).pathname,
    ...[...document.querySelectorAll<HTMLAnchorElement>('.nav a')].map((a) => new URL(a.href).pathname)];
  const rank = (u: URL) => order.findIndex((p) => norm(p) === norm(u.pathname));
  document.addEventListener('astro:before-preparation', (e) => {
    if ((e as Event & { navigationType: string }).navigationType === 'traverse') return;
    // The new page starts at the top. Jump there now, before the old page is captured for the slide;
    // otherwise the slide also travels up the page and looks diagonal.
    if (window.scrollY === 0) return;
    // Astro has just recorded where you were, for the Back button. The jump makes it record 0 instead, so put the
    // real position back right before the new page goes in (while this page's history entry is still the current one).
    const saved = history.state;
    window.scrollTo({ top: 0, behavior: 'instant' });
    document.addEventListener('astro:before-swap', () => {
      if (saved && history.state?.index === saved.index) history.replaceState(saved, '');
    }, { once: true });
    const ev = e as Event & { from: URL; to: URL; direction: string };
    const a = rank(ev.from), b = rank(ev.to);
    if (a >= 0 && b >= 0 && a !== b) ev.direction = b > a ? 'forward' : 'back';
  });
  // Clicking the page you're already on doesn't navigate (or slide); it just takes you back to the top (and closes the menu).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.brand, .nav a, .mnav a')];
  // the phone menu: opens and closes on its button, and closes on Escape, a tap outside it, or going to a page
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!, menu = document.querySelector<HTMLElement>('.mnav')!;
  const setMenu = (open: boolean) => { menu.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open)); };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
  document.addEventListener('pointerdown', (e) => { if (!menu.hidden && !(e.target as Element).closest?.('.mnav, .menu-btn')) setMenu(false); });
  document.addEventListener('astro:before-preparation', () => setMenu(false));
  matchMedia('(max-width:640px)').addEventListener('change', (m) => { if (!m.matches) setMenu(false); });
  const hereEl = document.querySelector<HTMLElement>('.site-header .here')!, siteName = document.querySelector('.brand')!.getAttribute('aria-label')!.replace(/, home$/, '');
  for (const a of links) a.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;   // new tab etc. behave as normal
    if (norm(new URL(a.href).pathname) !== norm(location.pathname)) return;
    e.preventDefault();
    setMenu(false);
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
  // keep the current-page marker in step with the page (the header itself isn't re-rendered)
  document.addEventListener('astro:page-load', () => {
    for (const a of links) {
      if (norm(new URL(a.href).pathname) === norm(location.pathname)) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    }
    // the phone header's page name: the current tab's title, or the site's name
    hereEl.textContent = document.querySelector('.nav a[aria-current="page"]')?.textContent ?? siteName;
    setMenu(false);
    // on a narrow screen the tab row scrolls sideways; bring the current tab into view if it's off the end
    const nav = document.querySelector<HTMLElement>('.nav'), cur = nav?.querySelector<HTMLElement>('[aria-current="page"]');
    if (nav && cur && (cur.offsetLeft < nav.scrollLeft || cur.offsetLeft + cur.offsetWidth > nav.scrollLeft + nav.clientWidth))
      nav.scrollLeft = cur.offsetLeft + cur.offsetWidth - nav.clientWidth + 8;
  });
</script>
