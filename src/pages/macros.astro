---
import Layout from '../layouts/Layout.astro';
import MacroGuide from '../components/MacroGuide.astro';
import PickSelect from '../components/PickSelect.astro';
import Stepper from '../components/Stepper.astro';
import { groups, flatChoices, SPELL_KIND, KIND_SAYS } from '../data/macros';
import { LIMIT, MAX_LEVEL, choice, fill, highlight, usesStones, stonesIn, stoneRank, cqsSlowsFiller, type Picked } from '../lib/macro';
import '../styles/macros.css';

const total = groups.reduce((n, g) => n + g.macros.length, 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// "Major Healthstone (58)": which rank a stone macro is using at this level
const rankNote = (body: string, level: number, picked: Picked) => stonesIn(body, picked).map((s) => {
  const [lvl, rank] = stoneRank(s, level);
  return `${rank ? `${rank} ` : ''}${s} (${lvl})`;
}).join(', ');
---
<Layout title="Macros" description="Copy-ready warlock macros for WoW Forever: casting, crowd control, demons and stones.">
  <div class="page-head">
    <h1>Macros</h1>
    <p>Warlock macros for WoW Forever, ready to copy. Paste one into the game's macro window (<code>/macro</code>), choose the question-mark icon, and drag it to your bars.</p>
  </div>

  <!-- two tabs: the macro library, and the guide with its builder (#guide links straight to it) -->
  <div class="mtabs" role="tablist" aria-label="Macros">
    <button type="button" role="tab" id="tab-lib" aria-controls="panel-lib" aria-selected="true">Library</button>
    <button type="button" role="tab" id="tab-guide" aria-controls="panel-guide" aria-selected="false" tabindex="-1">Guide &amp; builder</button>
  </div>

  <div class="mpanel" id="panel-lib" role="tabpanel" aria-labelledby="tab-lib">
  <div class="mtools">
    <span id="mcount" class="muted" aria-live="polite">{total} macros</span>
    <label class="search">
      <span class="sr-only">Search macros, spells and notes</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <input id="mq" type="search" placeholder="Search" autocomplete="off">
    </label>
    <div class="mlevel" title="The stone macros use the best Healthstone, Soulstone and Spellstone you can make at this level">
      <label for="mlevel">Stones for level</label>
      <Stepper id="mlevel" label="stone level" min={1} max={MAX_LEVEL} value={MAX_LEVEL} size="lg" />
    </div>
    <nav class="jump muted" aria-label="Groups">
      {groups.map((g) => <a href={`#${slug(g.group)}`}>{g.group}</a>)}
    </nav>
  </div>

  {groups.map((g) => (
    <section class="mgroup master" id={slug(g.group)}>
      <h2 class="card-h">{g.group} <span class="muted">{g.blurb}</span></h2>
      <div class="mgrid master-b">
        {g.macros.map((m) => {
          const picks = (m.picks ?? []).map((p) => ({ ...p, choices: flatChoices(p).map(choice),
            // what the <select> shows: options, or headed groups of them
            menu: p.choices.map((c) => (typeof c === 'object' && !Array.isArray(c) ? { group: c.group, options: c.choices.map(choice) } : { option: choice(c) })) }));
          const picked: Picked = Object.fromEntries(picks.map((p) => [p.token, p.default ?? p.choices[0]?.[1] ?? '']));
          const derive = { cqs: m.cqs, reset: m.reset };
          const text = fill(m.body, MAX_LEVEL, picked, derive);
          const slowed = cqsSlowsFiller(picked, m.cqs);
          // a stone card: its body, or one of its choices, uses the level box (the rank dropdowns' "Your level")
          const stones = usesStones(m.body) || picks.some((p) => p.choices.some((c) => usesStones(c[1])));
          // controls in cells: a modifier ("on") shares its subject's cell, e.g. [Trinkets ▾] on [Shift ▾]
          const cells: { a: (typeof picks)[number]; on?: (typeof picks)[number] }[] = [];
          for (let i = 0; i < picks.length; i++) {
            if (picks[i + 1]?.label === 'on') { cells.push({ a: picks[i], on: picks[i + 1] }); i++; } else cells.push({ a: picks[i] });
          }
          // a long note shows its first sentence, with the rest behind "More"
          const [lead, rest] = m.note.length > 170 ? (m.note.match(/^(.+?[.!?])\s+(.+)$/s)?.slice(1) ?? [m.note, '']) : [m.note, ''];
          const search = [m.name, m.note, m.needs, text, ...picks.flatMap((p) => p.choices.map((c) => c[0]))].filter(Boolean).join(' ').toLowerCase();
          return (
            <article class:list={['macro', { wide: picks.length > 2 }]} data-search={search}>
              <header>
                <h3>{m.name}</h3>
                <button type="button" class="pill copy" aria-label={`Copy ${m.name}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
                  <span class="labels"><span class="a">Copy</span><span class="b" aria-hidden="true">Copied</span></span>
                </button>
              </header>
              {picks.length > 0 && (
                <div class="picks">{cells.map(({ a: p, on }) => on ? (
                  <div class:list={['pick', 'pair', { full: p.wide }]}>
                    <span class="pl">{p.label}</span>
                    <div class="pair-in">
                      <PickSelect token={p.token} menu={p.menu} value={picked[p.token]} label={p.label} />
                      <span class="on-l">on</span>
                      <PickSelect token={on.token} menu={on.menu} value={picked[on.token]} label={`${p.label}: which key`} class="mod" />
                    </div>
                  </div>
                ) : p.type === 'checks' ? (
                  <fieldset class="pick checks full" data-token={p.token}>
                    <legend class="pl">{p.label}</legend>
                    <div class="checks-in">{p.choices.map(([label, value]) => <label><input type="checkbox" value={value} checked={picked[p.token].split('/').includes(value)}> {label}</label>)}</div>
                  </fieldset>
                ) : p.type === 'number' ? (
                  <div class:list={['pick', 'num', { full: p.wide }]}>
                    <span class="pl" aria-hidden="true">{p.label}</span>
                    <Stepper data-token={p.token} aria-label={p.label} label={p.label.toLowerCase()} min={1} max={600} placeholder="off" value={picked[p.token]} size="sm" wide />
                  </div>
                ) : (
                  <label class:list={['pick', { full: p.wide }]}>
                    <span class="pl">{p.label}</span>
                    <PickSelect token={p.token} menu={p.menu} value={picked[p.token]} />
                  </label>
                ))}</div>
              )}
              <pre class="code" data-body={stones || picks.length ? m.body : undefined} data-derive={m.cqs || m.reset ? JSON.stringify(derive) : undefined}><code set:html={highlight(text)} /></pre>
              {m.validate && <p class="mwarn" role="status" hidden data-validate={JSON.stringify({ ...m.validate, kinds: SPELL_KIND, says: KIND_SAYS })}></p>}
              {m.cqs && (
                <p class="cqs-warn" role="status" hidden={!slowed}>
                  <strong>/cqs runs on your unmodified presses.</strong> Every <span class="cqs-spell">{slowed}</span> then waits for the cast before it to finish before it starts, so your filler gets slower. Put the cooldowns on a modifier key to keep unmodified presses at full speed.
                </p>
              )}
              {rest ? (
                <details class="note">
                  <summary>{lead} <span class="more" aria-hidden="true"></span></summary>
                  <p>{rest}</p>
                </details>
              ) : <p class="note">{m.note}</p>}
              <footer>
                {m.needs && <span class="badge">{m.needs}</span>}
                {stones && <span class="rank muted">{rankNote(m.body, MAX_LEVEL, picked)}</span>}
                <span class={`chars muted${text.length > LIMIT ? ' over' : ''}`} title={`Macros can be up to ${LIMIT} characters`}>{text.length}/{LIMIT}</span>
              </footer>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <p id="mnone" class="empty muted" hidden>No macros match. <button type="button" class="link" id="mclear">Clear the search</button></p>

  <script>import '../scripts/macros';</script>

  <div class="notes">
    <p>Written for the Classic client's macro syntax. <code>[mod:shift]</code> and friends check the key as you press the button, so they work from keybinds too. <code>@mouseover</code> means the unit under your cursor, including its unit frame; the empty <code>[]</code> after it falls back to your target.</p>
    <p><code>#showtooltip</code> makes the button show the spell it will cast (and its cooldown) when you give the macro the question-mark icon. Macros without it need an icon picked by hand.</p>
    <p>Spell and item names have to match the game exactly, rank words included. The stone macros follow the level you set above (it's kept in this browser); the number by each stone is the level its rank is learned. Forever is still in testing, so if a name or command has changed, swap it in before you save.</p>
  </div>
  </div>

  <div class="mpanel" id="panel-guide" role="tabpanel" aria-labelledby="tab-guide" hidden>
    <MacroGuide />
    <script>import '../scripts/macro-builder';</script>
  </div>
</Layout>
