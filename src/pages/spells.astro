---
// Spells by level: every spell and rank a warlock learns, in level order, with how each is learned. Your level splits
// the list into what you can have by now, what comes next, and the rest. scripts/spells.ts drives it.
import Layout from '../layouts/Layout.astro';
import LevelBar from '../components/LevelBar.astro';
import { spellbook, wowhead, type Spell } from '../data/spellbook';
import { url } from '../lib/url';
import '../styles/spells.css';

const LEVEL = 10;   // before any saved choice
const { spells } = spellbook;
const next = Math.min(...spells.filter((s) => s.level > LEVEL).map((s) => s.level));
const state = (s: Spell) => (s.level <= LEVEL ? 'have' : s.level === next ? 'next' : null);
const trees = ['Affliction', 'Demonology', 'Destruction'];
---
<Layout title="Warlock spells by level" description="Every spell and rank a WoW Forever warlock learns, level by level, and whether it comes from a trainer, a talent, a quest or a book.">
  <div class="page-head">
    <h1>Warlock spells by level</h1>
    <p>Your own spells, not your demons': every spell and rank a warlock learns, in the order you get them, and where each comes from. Set your level to see what you should have by now and what the next trip to the trainer brings.</p>
  </div>

  <LevelBar id="sp-bar" level={LEVEL}>
    <div class="seg" role="group" aria-label="Tree" data-name="tree">
      <button type="button" data-v="all" aria-pressed="true">All</button>
      {trees.map((t) => <button type="button" data-v={t} aria-pressed="false">{t}</button>)}
    </div>
    <label class="check"><input type="checkbox" data-name="fresh">New spells only</label>
    <label class="check"><input type="checkbox" data-name="ahead">Hide what I have</label>
  </LevelBar>

  <section class="card full sp-card" aria-labelledby="sp-h">
    <div class="card-h"><h2 id="sp-h">Spellbook <span class="muted" id="sp-count"></span></h2></div>
    <div class="tscroll">
      <table class="dtable sp-table">
        <thead>
          <tr><th scope="col" class="num">Level</th><th scope="col">Spell</th><th scope="col" class="sp-tree">Tree</th><th scope="col">How you get it</th></tr>
        </thead>
        <tbody>
          {spells.map((s, i) => (
            <tr data-level={s.level} data-tree={s.tree} data-first={s.first ? '' : undefined} class:list={[state(s), { top: s.level !== spells[i - 1]?.level, odd: i % 2 === 0 }]}>
              <td class="num sp-lv">{s.level}</td>
              <th scope="row">
                <span class="sp-name">
                  <a class="link" href={wowhead('spell', s.id)} target="_blank" rel="noopener">{s.name}</a>
                  {s.rank && <span class="muted sp-rank">Rank {s.rank}</span>}
                  {s.first && <span class="badge" title="A new spell, not a higher rank of one you have">New</span>}
                </span>
              </th>
              <td class="sp-tree muted">{s.tree}</td>
              <td class="sp-how">
                {s.how === 'start' && 'You start with it'}
                {s.how === 'train' && (s.talent ? <>Trainer <span class="muted">· needs the talent</span></> : 'Trainer')}
                {s.how === 'talent' && <><span class="badge sp-talent">Talent</span> <span class="muted">at the earliest</span></>}
                {s.how === 'quest' && <a class="link" href={url(`quests/#${s.quest}`)}>Class quest</a>}
                {s.how === 'item' && <>Book <span class="muted">· {s.item}</span></>}
                {s.how === 'unknown' && <span class="muted">Not known yet</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty muted" hidden>Nothing left to learn with these choices.</p>
  </section>

  <script>import '../scripts/spells';</script>
</Layout>
